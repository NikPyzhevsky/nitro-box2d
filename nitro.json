{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrobox2d"
  ],
  "ios": {
    "iosModuleName": "NitroBox2d"
  },
  "android": {
    "androidNamespace": [
      "nitrobox2d"
    ],
    "androidCxxLibName": "NitroBox2d"
  },
  "autolinking": {
    "Box2D": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridBox2D"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "third_party/**"
  ]
}
